PORT=3000
SESSION_SECRET=change-me-in-production
SITE_URL=https://laviewaterhanoi.vn

DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=bmb_vietnam

# Only used by docker-compose.yml to bootstrap the mysql container's root
# password on first run — the app itself never reads this var.
DB_ROOT_PASSWORD=change-me-in-production

# Only used by docker-compose.yml: host path where MySQL data and uploaded
# images are bind-mounted (persists across container rebuilds/removal).
# Leave unset to use the default, /opt/bmb-vietnam/data.
# DATA_DIR=/opt/bmb-vietnam/data
