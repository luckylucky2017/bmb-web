<%
  const articleImageUrl = /^https?:\/\//.test(article.image) ? article.image : `${siteUrl}${article.image}`;
  const articleSchema = {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: article.title,
    image: [articleImageUrl],
    datePublished: new Date(article.published_at).toISOString(),
    dateModified: new Date(article.updated_at || article.published_at).toISOString(),
    author: { "@type": "Organization", name: site.company_full_name },
    publisher: {
      "@type": "Organization",
      name: siteName,
      logo: { "@type": "ImageObject", url: `${siteUrl}/images/logo.svg` }
    },
    mainEntityOfPage: `${siteUrl}/tin-tuc/${article.slug}`
  };
  const breadcrumbSchema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Trang chủ", item: siteUrl },
      { "@type": "ListItem", position: 2, name: "Tin tức", item: `${siteUrl}/tin-tuc` },
      { "@type": "ListItem", position: 3, name: article.title, item: `${siteUrl}/tin-tuc/${article.slug}` }
    ]
  };
%>
<script type="application/ld+json"><%- JSON.stringify(articleSchema) %></script>
<script type="application/ld+json"><%- JSON.stringify(breadcrumbSchema) %></script>

<section class="border-b border-slate-100 bg-sand-50 py-4">
  <div class="container-page text-sm text-slate-500">
    <a href="/" class="hover:text-brand-600">Trang chủ</a> <span class="mx-1">/</span>
    <a href="/tin-tuc" class="hover:text-brand-600">Tin tức</a> <span class="mx-1">/</span>
    <span class="text-slate-700"><%= article.title %></span>
  </div>
</section>

<section class="py-16">
  <div class="container-page mx-auto max-w-3xl">
    <div class="flex items-center gap-3 text-xs font-semibold text-brand-500">
      <span><%= article.category %></span>
      <span class="h-1 w-1 rounded-full bg-slate-300"></span>
      <span class="text-slate-400"><%= formatDate(article.published_at) %></span>
    </div>
    <h1 class="mt-4 font-display text-3xl font-extrabold leading-tight text-slate-900 sm:text-4xl"><%= article.title %></h1>

    <div class="mt-8 aspect-[16/9] overflow-hidden rounded-2xl">
      <img src="<%= article.image %>" alt="<%= article.title %>" class="h-full w-full object-cover" />
    </div>

    <div class="prose prose-slate mt-10 max-w-none leading-relaxed text-slate-600 [&_p]:mb-5">
      <%- article.content %>
    </div>
  </div>
</section>

<% if (related && related.length) { %>
<section class="bg-white py-16">
  <div class="container-page mx-auto max-w-3xl">
    <h2 class="font-display text-xl font-bold text-slate-900">Bài viết liên quan</h2>
    <div class="mt-6 grid grid-cols-1 gap-6 sm:grid-cols-2">
      <% related.forEach(function(n) { %>
        <a href="/tin-tuc/<%= n.slug %>" class="card group overflow-hidden">
          <div class="aspect-[16/10] overflow-hidden">
            <img src="<%= n.image %>" alt="<%= n.title %>" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" />
          </div>
          <div class="p-5">
            <h3 class="font-display text-base font-bold leading-snug text-slate-900 group-hover:text-brand-600"><%= n.title %></h3>
          </div>
        </a>
      <% }); %>
    </div>
  </div>
</section>
<% } %>
