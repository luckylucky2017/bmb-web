<!-- Hero -->
<section class="relative h-[640px] overflow-hidden text-white sm:h-[720px]">
  <img src="/images/hero/hero-main.svg" alt="Nước khoáng Lavie" class="absolute inset-0 h-full w-full object-cover" />
  <div class="absolute inset-0 bg-gradient-to-b from-brand-950/20 via-brand-950/10 to-brand-950/60"></div>

  <!-- side vertical tab -->
  <a href="/dai-ly" class="absolute left-0 top-1/2 z-10 hidden -translate-y-1/2 items-center rounded-r-lg bg-brand-600/90 px-2 py-6 text-xs font-bold uppercase tracking-widest text-white shadow-card sm:flex">
    <span class="[writing-mode:vertical-rl]">Khu vực giao hàng</span>
  </a>

  <div class="relative container-page flex h-full flex-col items-center justify-center text-center">
    <span class="section-eyebrow bg-white/15 text-white backdrop-blur">Đại lý phân phối chính thức Lavie tại Hà Nội</span>
    <h1 class="mt-6 max-w-3xl font-display text-4xl font-extrabold uppercase leading-tight tracking-wide sm:text-5xl lg:text-6xl">
      Nước khoáng Lavie chính hãng<br class="hidden sm:block" /> giao tận nhà tại Hà Nội
    </h1>
    <p class="mt-5 max-w-xl text-lg text-white/85">
      BMB Việt Nam - đại lý cấp 1 của Lavie khu vực Hà Nội. Đặt nước nhanh chóng, giao trong ngày, đổi bình miễn phí cho hộ gia đình và văn phòng.
    </p>
    <div class="mt-9 flex flex-wrap justify-center gap-4">
      <a href="/san-pham" class="btn-primary">Đặt nước ngay</a>
      <a href="/dai-ly" class="btn-outline">Xem khu vực giao hàng</a>
    </div>
  </div>

  <!-- carousel dots -->
  <div class="absolute bottom-8 left-1/2 z-10 flex -translate-x-1/2 gap-2">
    <span class="h-2 w-2 rounded-full bg-white/50"></span>
    <span class="h-2.5 w-2.5 rounded-full bg-white"></span>
    <span class="h-2 w-2 rounded-full bg-white/50"></span>
    <span class="h-2 w-2 rounded-full bg-white/50"></span>
    <span class="h-2 w-2 rounded-full bg-white/50"></span>
  </div>
</section>

<!-- Trust bar -->
<section class="bg-sand-50 py-10">
  <div class="container-page flex flex-wrap items-center justify-between gap-6 text-sm font-semibold text-slate-500">
    <p class="text-slate-400">Phục vụ đa dạng khách hàng tại Hà Nội:</p>
    <div class="flex flex-wrap items-center gap-x-10 gap-y-3 opacity-70">
      <span>🏠 Hộ gia đình</span>
      <span>🏢 Văn phòng</span>
      <span>🏫 Trường học</span>
      <span>🍜 Nhà hàng - Quán ăn</span>
      <span>🏋️ Phòng gym</span>
    </div>
  </div>
</section>

<!-- Why us -->
<section class="py-20">
  <div class="container-page">
    <div class="max-w-xl">
      <span class="section-eyebrow">Vì sao chọn BMB Việt Nam</span>
      <h2 class="section-title">Đại lý Lavie uy tín, giao hàng đúng hẹn</h2>
    </div>
    <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      <div class="card p-7">
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-50 text-2xl">✅</div>
        <h3 class="mt-5 font-display text-lg font-bold text-slate-900">Hàng chính hãng 100%</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-500">Nhập hàng trực tiếp từ Lavie, có tem đại lý, hạn sử dụng luôn mới.</p>
      </div>
      <div class="card p-7">
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-aqua-500/10 text-2xl">🚴</div>
        <h3 class="mt-5 font-display text-lg font-bold text-slate-900">Giao hàng trong ngày</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-500">Đội xe giao hàng riêng, phục vụ nội thành trong 2-4 giờ.</p>
      </div>
      <div class="card p-7">
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-leaf-500/10 text-2xl">♻️</div>
        <h3 class="mt-5 font-display text-lg font-bold text-slate-900">Đổi bình miễn phí</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-500">Thu hồi vỏ bình cũ ngay khi giao hàng mới, không phát sinh phí.</p>
      </div>
      <div class="card p-7">
        <div class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-50 text-2xl">📅</div>
        <h3 class="mt-5 font-display text-lg font-bold text-slate-900">Đặt hàng định kỳ</h3>
        <p class="mt-2 text-sm leading-relaxed text-slate-500">Hỗ trợ lịch giao cố định hàng tuần/tháng cho văn phòng, trường học.</p>
      </div>
    </div>
  </div>
</section>

<!-- Products -->
<section class="bg-white py-20">
  <div class="container-page">
    <div class="flex flex-wrap items-end justify-between gap-6 border-b border-slate-100 pb-6">
      <h2 class="font-display text-2xl font-extrabold uppercase tracking-wide text-brand-950 sm:text-3xl">Sản phẩm Lavie do BMB Việt Nam phân phối</h2>
      <a href="/san-pham" class="btn-ghost">Xem tất cả sản phẩm</a>
    </div>

    <div class="mt-10 grid grid-cols-2 gap-5 sm:grid-cols-3 lg:grid-cols-4">
      <% products.forEach(function(p) { %>
        <a href="/san-pham/<%= p.slug %>" class="group flex flex-col overflow-hidden rounded-lg border border-slate-100 p-5 text-center transition hover:border-brand-200 hover:shadow-card">
          <div class="flex aspect-square items-center justify-center">
            <img src="<%= p.image %>" alt="<%= p.name %>" class="h-full w-full object-contain transition-transform duration-300 group-hover:scale-105" />
          </div>
          <h3 class="mt-4 font-display text-sm font-extrabold uppercase leading-snug text-brand-700 group-hover:text-brand-600"><%= p.name %></h3>
          <p class="mt-2 text-lg font-extrabold text-accent-600"><%= formatVND(p.price) %></p>
        </a>
      <% }); %>
    </div>
  </div>
</section>

<!-- Service commitment banner -->
<section class="relative overflow-hidden bg-gradient-to-r from-leaf-600 to-aqua-600 py-20 text-white">
  <div class="container-page grid items-center gap-10 lg:grid-cols-2">
    <div>
      <span class="section-eyebrow bg-white/15 text-white">Cam kết dịch vụ</span>
      <h2 class="mt-4 font-display text-3xl font-extrabold leading-tight sm:text-4xl">Đồng hành cùng khách hàng Hà Nội mỗi ngày</h2>
      <p class="mt-4 max-w-lg text-leaf-50/90">
        Từ hàng chính hãng, giao nhanh đúng hẹn đến thu hồi vỏ bình bảo vệ môi trường - đó là cam kết của BMB Việt Nam trong từng đơn hàng.
      </p>
      <a href="/phat-trien-ben-vung" class="btn-outline mt-7">Xem cam kết dịch vụ</a>
    </div>
    <div class="grid grid-cols-2 gap-5">
      <div class="rounded-2xl bg-white/10 p-6 backdrop-blur">
        <p class="font-display text-3xl font-extrabold">15+</p>
        <p class="mt-1 text-sm text-leaf-50/90">Quận huyện phục vụ tại Hà Nội</p>
      </div>
      <div class="rounded-2xl bg-white/10 p-6 backdrop-blur">
        <p class="font-display text-3xl font-extrabold">5.000+</p>
        <p class="mt-1 text-sm text-leaf-50/90">Vỏ bình thu hồi mỗi tháng</p>
      </div>
      <div class="rounded-2xl bg-white/10 p-6 backdrop-blur">
        <p class="font-display text-3xl font-extrabold">100%</p>
        <p class="mt-1 text-sm text-leaf-50/90">Hàng chính hãng Lavie</p>
      </div>
      <div class="rounded-2xl bg-white/10 p-6 backdrop-blur">
        <p class="font-display text-3xl font-extrabold">2-4h</p>
        <p class="mt-1 text-sm text-leaf-50/90">Thời gian giao hàng nội thành</p>
      </div>
    </div>
  </div>
</section>

<!-- News -->
<section class="py-20">
  <div class="container-page">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-xl">
        <span class="section-eyebrow">Tin tức</span>
        <h2 class="section-title">Cập nhật mới nhất từ BMB</h2>
      </div>
      <a href="/tin-tuc" class="btn-ghost">Xem tất cả tin tức</a>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-6 lg:grid-cols-3">
      <% news.forEach(function(n) { %>
        <a href="/tin-tuc/<%= n.slug %>" class="card group overflow-hidden">
          <div class="aspect-[16/10] overflow-hidden">
            <img src="<%= n.image %>" alt="<%= n.title %>" class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" />
          </div>
          <div class="p-6">
            <div class="flex items-center gap-3 text-xs font-semibold text-brand-500">
              <span><%= n.category %></span>
              <span class="h-1 w-1 rounded-full bg-slate-300"></span>
              <span class="text-slate-400"><%= formatDate(n.published_at) %></span>
            </div>
            <h3 class="mt-3 font-display text-lg font-bold leading-snug text-slate-900 group-hover:text-brand-600"><%= n.title %></h3>
            <p class="mt-2 line-clamp-2 text-sm text-slate-500"><%= n.excerpt %></p>
          </div>
        </a>
      <% }); %>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="bg-brand-950 py-16 text-white">
  <div class="container-page flex flex-col items-center gap-6 text-center">
    <h2 class="font-display text-2xl font-extrabold sm:text-3xl">Đặt nước Lavie ngay hôm nay</h2>
    <p class="max-w-xl text-brand-100">Giao hàng nhanh trong ngày tại nội thành Hà Nội. Hỗ trợ đặt lẻ hoặc đăng ký giao định kỳ cho gia đình, văn phòng.</p>
    <a href="/lien-he" class="btn-primary">Liên hệ đặt hàng</a>
  </div>
</section>
