<%- include('../partials/page-header', { pageTitle: 'Giỏ hàng', pageSubtitle: 'Xem lại sản phẩm đã chọn trước khi đặt hàng.', eyebrow: 'Đặt hàng online' }) %>

<section class="py-16">
  <div class="container-page mx-auto max-w-3xl">
    <% if (typeof orderSubmitted !== 'undefined' && orderSubmitted) { %>
      <div class="rounded-2xl border border-leaf-500/30 bg-leaf-500/10 p-8 text-center">
        <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-leaf-500 text-2xl text-white">✓</div>
        <h2 class="mt-4 font-display text-xl font-bold text-slate-900">Đặt hàng thành công!</h2>
        <p class="mt-2 text-sm text-slate-600">Cảm ơn bạn đã đặt hàng. Nhân viên BMB Việt Nam sẽ liên hệ xác nhận đơn hàng trong thời gian sớm nhất.</p>
        <a href="/san-pham" class="btn-primary mt-6">Tiếp tục xem sản phẩm</a>
      </div>
    <% } else if (!items.length) { %>
      <div class="rounded-2xl border border-slate-100 bg-white p-10 text-center shadow-soft">
        <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-brand-50 text-2xl">🛒</div>
        <h2 class="mt-4 font-display text-xl font-bold text-slate-900">Giỏ hàng đang trống</h2>
        <p class="mt-2 text-sm text-slate-500">Chọn sản phẩm và bấm "Thêm vào giỏ" để bắt đầu đặt hàng.</p>
        <a href="/san-pham" class="btn-primary mt-6">Xem sản phẩm</a>
      </div>
    <% } else { %>
      <div class="rounded-2xl border border-slate-100 bg-white p-6 shadow-soft sm:p-8">
        <h2 class="font-display text-lg font-bold text-slate-900">Sản phẩm trong giỏ (<%= items.length %>)</h2>
        <div class="mt-6 space-y-5">
          <% items.forEach(function(item) { %>
            <div class="flex flex-wrap items-center gap-4 border-b border-slate-100 pb-5">
              <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-lg bg-sand-100">
                <img src="<%= item.product.image %>" alt="<%= item.product.name %>" class="h-full w-full object-contain p-1" />
              </div>
              <div class="min-w-0 flex-1">
                <a href="/san-pham/<%= item.product.slug %>" class="line-clamp-1 font-display text-sm font-extrabold uppercase text-brand-700 hover:text-brand-600"><%= item.product.name %></a>
                <p class="mt-1 text-sm font-bold text-accent-600"><%= formatVND(item.product.price) %></p>
              </div>
              <form action="/gio-hang/cap-nhat" method="POST" class="flex items-center gap-2">
                <input type="number" name="quantity_<%= item.product.id %>" value="<%= item.quantity %>" min="0" max="999" class="form-input w-20 !py-2 text-center" />
                <button type="submit" class="admin-btn-outline !px-3 !py-2 text-xs">Cập nhật</button>
              </form>
              <p class="w-28 shrink-0 text-right text-sm font-extrabold text-slate-900"><%= formatVND(item.lineTotal) %></p>
              <form action="/gio-hang/xoa" method="POST">
                <input type="hidden" name="product_id" value="<%= item.product.id %>" />
                <button type="submit" aria-label="Xoá sản phẩm" class="text-xs font-semibold text-red-500 hover:underline">Xoá</button>
              </form>
            </div>
          <% }); %>
        </div>

        <div class="mt-6 flex items-center justify-between border-t border-slate-100 pt-6">
          <span class="font-display text-base font-bold text-slate-900">Tổng cộng</span>
          <span class="font-display text-xl font-extrabold text-accent-600"><%= formatVND(total) %></span>
        </div>
      </div>

      <div class="mt-8 rounded-2xl border border-slate-100 bg-white p-6 shadow-soft sm:p-8">
        <span class="section-eyebrow">Xác nhận đặt hàng</span>
        <h2 class="mt-3 font-display text-xl font-bold text-slate-900">Thông tin giao hàng</h2>
        <p class="mt-2 text-sm text-slate-500">Điền thông tin bên dưới, chúng tôi sẽ gọi điện xác nhận trước khi giao hàng.</p>
        <form action="/gio-hang/dat-hang" method="POST" class="mt-6 space-y-5">
          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label class="form-label">Họ và tên</label>
              <input type="text" name="customer_name" required class="form-input mt-2" />
            </div>
            <div>
              <label class="form-label">Số điện thoại</label>
              <input type="tel" name="phone" required class="form-input mt-2" />
            </div>
          </div>
          <div>
            <label class="form-label">Email (không bắt buộc)</label>
            <input type="email" name="email" class="form-input mt-2" />
          </div>
          <div>
            <label class="form-label">Địa chỉ giao hàng</label>
            <input type="text" name="address" required class="form-input mt-2" />
          </div>
          <div>
            <label class="form-label">Ghi chú</label>
            <textarea name="note" rows="3" class="form-input mt-2"></textarea>
          </div>
          <button type="submit" class="btn-primary w-full">Xác nhận đặt hàng &mdash; <%= formatVND(total) %></button>
        </form>
      </div>
    <% } %>
  </div>
</section>
