<!-- Vertical side ad banners, e-commerce style. `.container-page` caps main
     content at 1280px + its own 40px inner padding (lg:px-10), so real
     content sits (viewport-1280)/2 + 40 from each edge. At 1440px that's
     120px clear — a 96px banner fits with room to spare, which is why the
     breakpoint below is 1440px (an arbitrary Tailwind value, not a stock
     one) rather than the default 2xl (1536px): 2xl alone would hide these
     on most 13"/14" laptop screens, where nothing would ever show. -->
<% if (adBannersLeft && adBannersLeft.length) { %>
  <div class="pointer-events-none fixed inset-y-0 left-0 z-30 hidden w-24 items-center justify-center min-[1440px]:flex">
    <div class="flex flex-col gap-4">
      <% adBannersLeft.forEach(function(b) { %>
        <a href="<%= b.link_url || '#' %>" <%= (b.link_url || '').startsWith('http') ? 'target="_blank" rel="noopener"' : '' %> class="pointer-events-auto block overflow-hidden rounded-xl shadow-card transition hover:opacity-90">
          <img src="<%= b.image %>" alt="<%= b.alt_text || '' %>" class="w-24" />
        </a>
      <% }); %>
    </div>
  </div>
<% } %>
<% if (adBannersRight && adBannersRight.length) { %>
  <div class="pointer-events-none fixed inset-y-0 right-0 z-30 hidden w-24 items-center justify-center min-[1440px]:flex">
    <div class="flex flex-col gap-4">
      <% adBannersRight.forEach(function(b) { %>
        <a href="<%= b.link_url || '#' %>" <%= (b.link_url || '').startsWith('http') ? 'target="_blank" rel="noopener"' : '' %> class="pointer-events-auto block overflow-hidden rounded-xl shadow-card transition hover:opacity-90">
          <img src="<%= b.image %>" alt="<%= b.alt_text || '' %>" class="w-24" />
        </a>
      <% }); %>
    </div>
  </div>
<% } %>
