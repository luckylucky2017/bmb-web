<%
  const navItems = [
    { href: "/", label: "Trang chủ" },
    { href: "/gioi-thieu", label: "Giới thiệu" },
    { href: "/san-pham", label: "Sản phẩm" },
    { href: "/tin-tuc", label: "Tin tức" },
    { href: "/phat-trien-ben-vung", label: "Dịch vụ" },
    { href: "/dai-ly", label: "Giao hàng" },
    { href: "/tuyen-dung", label: "Tuyển dụng" },
    { href: "/lien-he", label: "Liên hệ" }
  ];
%>
<header class="sticky top-0 z-50 border-b border-slate-100 bg-white shadow-sm">
  <div class="mx-auto flex h-20 max-w-[1440px] items-center justify-between gap-3 px-5 sm:px-8 lg:px-10">
    <a href="/" class="flex shrink-0 items-center">
      <img src="/images/logo.svg" alt="BMB Việt Nam" class="h-10 w-auto sm:h-11" />
    </a>

    <nav class="hidden items-center gap-3 xl:flex xl:gap-4">
      <% navItems.forEach(function(item) { %>
        <a href="<%= item.href %>" class="relative whitespace-nowrap py-1 text-[13px] font-bold uppercase tracking-wide <%= currentPath === item.href ? 'text-brand-600' : 'text-brand-950 hover:text-brand-600' %>">
          <%= item.label %>
          <% if (currentPath === item.href) { %>
            <span class="absolute -bottom-1 left-0 h-0.5 w-full rounded-full bg-brand-600"></span>
          <% } %>
        </a>
      <% }); %>
    </nav>

    <div class="hidden items-center gap-3 xl:flex xl:gap-4">
      <a href="/lien-he" class="btn shrink-0 whitespace-nowrap !px-5 bg-red-600 text-white shadow-soft hover:bg-red-700">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.5-9.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 8.5-8.5Z" />
        </svg>
        Đặt nước
      </a>
      <button
        type="button"
        class="js-call-trigger flex shrink-0 items-center gap-2 whitespace-nowrap border-l border-slate-200 pl-4"
        data-tel="<%= (site.hotline || '').replace(/\s+/g, '') %>"
        data-tel2="<%= (site.hotline_2 || '').replace(/\s+/g, '') %>"
      >
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-red-50 text-red-600">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.4 21 3 13.6 3 4.6 3 4 3.4 3.6 4 3.6h3.4c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.4 0 .8-.3 1.1L6.6 10.8Z"/></svg>
        </span>
        <span class="leading-tight text-left">
          <span class="block text-[11px] font-semibold uppercase text-slate-400">Hotline đặt hàng</span>
          <span class="block text-base font-extrabold text-red-600"><%= site.hotline %></span>
        </span>
      </button>
    </div>

    <button id="menu-toggle" type="button" aria-label="Mở menu" class="flex h-10 w-10 items-center justify-center rounded-lg text-brand-700 xl:hidden">
      <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="hidden h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden border-t border-slate-100 bg-white xl:hidden">
    <nav class="container-page flex flex-col gap-1 py-4">
      <% navItems.forEach(function(item) { %>
        <a href="<%= item.href %>" class="rounded-lg px-3 py-2.5 text-sm font-bold uppercase <%= currentPath === item.href ? 'bg-brand-50 text-brand-700' : 'text-brand-950' %>">
          <%= item.label %>
        </a>
      <% }); %>
      <a href="/lien-he" class="btn mt-2 w-full bg-red-600 text-white hover:bg-red-700">Đặt nước</a>
      <p class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 px-3 text-sm font-extrabold text-red-600">
        <span>📞</span>
        <a href="tel:<%= (site.hotline || '').replace(/\s+/g, '') %>" class="hover:underline"><%= site.hotline %></a>
        <% if (site.hotline_2) { %>
          <span class="text-slate-300">·</span>
          <a href="tel:<%= site.hotline_2.replace(/\s+/g, '') %>" class="hover:underline"><%= site.hotline_2 %></a>
        <% } %>
      </p>
    </nav>
  </div>
</header>

<!-- Floating sticky contact widgets: a full-width bottom bar with all 3
     actions on mobile (fixed height, so it only ever covers a thin,
     predictable strip instead of a tall stack of circles drifting over
     content), the fuller icon stack + hotline pill from sm: up where
     there's room to float them without covering anything important. -->
<div class="fixed inset-x-0 bottom-0 z-40 flex items-stretch border-t border-slate-200 bg-white shadow-card sm:hidden">
  <button
    type="button"
    class="js-call-trigger flex flex-1 flex-col items-center justify-center gap-0.5 py-2 text-red-600 active:bg-slate-50"
    aria-label="Gọi hotline đặt hàng"
    data-tel="<%= (site.hotline || '').replace(/\s+/g, '') %>"
    data-tel2="<%= (site.hotline_2 || '').replace(/\s+/g, '') %>"
  >
    <span class="text-lg leading-none">📞</span>
    <span class="text-[10px] font-semibold leading-none">Gọi ngay</span>
  </button>
  <a href="<%= site.zalo_url || '#' %>" target="_blank" rel="noopener" class="flex flex-1 flex-col items-center justify-center gap-0.5 border-l border-slate-100 py-2 text-blue-600 active:bg-slate-50">
    <span class="flex h-5 w-5 items-center justify-center rounded-full bg-blue-500 text-[9px] font-black leading-none text-white">Za</span>
    <span class="text-[10px] font-semibold leading-none">Zalo</span>
  </a>
  <a href="<%= site.facebook_url || '#' %>" target="_blank" rel="noopener" class="flex flex-1 flex-col items-center justify-center gap-0.5 border-l border-slate-100 py-2 text-brand-600 active:bg-slate-50">
    <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06C2 17.08 5.66 21.23 10.44 22v-7.03H7.9v-2.9h2.54V9.85c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.87h2.78l-.44 2.9h-2.34V22C18.34 21.23 22 17.08 22 12.06Z"/></svg>
    <span class="text-[10px] font-semibold leading-none">Facebook</span>
  </a>
</div>

<div class="fixed bottom-24 right-5 z-40 hidden flex-col gap-3 sm:flex">
  <a href="<%= site.facebook_url || '#' %>" target="_blank" rel="noopener" aria-label="Facebook" class="flex h-12 w-12 items-center justify-center rounded-full bg-white shadow-card ring-1 ring-slate-100 transition hover:scale-105">
    <svg class="h-6 w-6 text-brand-600" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06C2 17.08 5.66 21.23 10.44 22v-7.03H7.9v-2.9h2.54V9.85c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.87h2.78l-.44 2.9h-2.34V22C18.34 21.23 22 17.08 22 12.06Z"/></svg>
  </a>
  <a href="<%= site.zalo_url || '#' %>" target="_blank" rel="noopener" aria-label="Chat Zalo" class="flex h-12 w-12 items-center justify-center rounded-full bg-blue-500 text-white shadow-card transition hover:scale-105">
    <span class="text-xs font-black">Zalo</span>
  </a>
</div>

<button
  type="button"
  class="js-call-trigger fixed bottom-5 left-5 z-40 hidden items-center gap-2 rounded-full bg-red-600 px-4 py-2.5 text-white shadow-card sm:flex"
  data-tel="<%= (site.hotline || '').replace(/\s+/g, '') %>"
  data-tel2="<%= (site.hotline_2 || '').replace(/\s+/g, '') %>"
>
  <span>📞</span>
  <span class="leading-tight text-left">
    <span class="block text-[10px] font-semibold uppercase text-red-100">Call / Zalo đặt hàng</span>
    <span class="block text-sm font-extrabold"><%= site.hotline %></span>
  </span>
</button>

<% if (site.hotline_2) { %>
  <!-- Mirrors the bottom-left hotline pill so the 2nd number is just as
       reachable, without going through the picker, from the opposite
       corner of the screen. -->
  <a
    href="tel:<%= site.hotline_2.replace(/\s+/g, '') %>"
    class="fixed right-5 top-24 z-40 hidden items-center gap-2 rounded-full bg-red-600 px-4 py-2.5 text-white shadow-card transition hover:bg-red-700 sm:flex"
  >
    <span>📞</span>
    <span class="leading-tight text-left">
      <span class="block text-[10px] font-semibold uppercase text-red-100">Call / Zalo đặt hàng</span>
      <span class="block text-sm font-extrabold"><%= site.hotline_2 %></span>
    </span>
  </a>
<% } %>

<!-- Call picker: opened by any .js-call-trigger when 2 hotlines are configured -->
<div id="call-picker" class="fixed inset-0 z-[60] hidden items-center justify-center bg-slate-900/60 px-4" role="dialog" aria-modal="true" aria-labelledby="call-picker-title">
  <div class="w-full max-w-xs rounded-2xl bg-white p-5 shadow-card">
    <div class="flex items-center justify-between">
      <h3 id="call-picker-title" class="font-display text-base font-bold text-slate-900">Chọn số để gọi</h3>
      <button type="button" id="call-picker-close" aria-label="Đóng" class="flex h-8 w-8 items-center justify-center rounded-full text-slate-400 hover:bg-slate-100 hover:text-slate-700">✕</button>
    </div>
    <div id="call-picker-options" class="mt-4 space-y-3"></div>
  </div>
</div>

<script src="/js/site.js"></script>
