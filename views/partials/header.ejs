<%
  const navItems = [
    { href: "/", label: "Trang chủ" },
    { href: "/gioi-thieu", label: "Giới thiệu" },
    { href: "/san-pham", label: "Sản phẩm" },
    { href: "/tin-tuc", label: "Tin tức" },
    { href: "/phat-trien-ben-vung", label: "Cam kết dịch vụ" },
    { href: "/dai-ly", label: "Khu vực giao hàng" },
    { href: "/tuyen-dung", label: "Tuyển dụng" },
    { href: "/lien-he", label: "Liên hệ" }
  ];
%>
<header class="sticky top-0 z-50 border-b border-slate-100 bg-white shadow-sm">
  <div class="container-page flex h-20 items-center justify-between gap-4">
    <a href="/" class="flex shrink-0 items-center">
      <img src="/images/logo.svg" alt="BMB Việt Nam" class="h-10 w-auto sm:h-11" />
    </a>

    <nav class="hidden items-center gap-6 xl:flex">
      <% navItems.forEach(function(item) { %>
        <a href="<%= item.href %>" class="relative py-1 text-[13px] font-bold uppercase tracking-wide <%= currentPath === item.href ? 'text-brand-600' : 'text-brand-950 hover:text-brand-600' %>">
          <%= item.label %>
          <% if (currentPath === item.href) { %>
            <span class="absolute -bottom-1 left-0 h-0.5 w-full rounded-full bg-brand-600"></span>
          <% } %>
        </a>
      <% }); %>
    </nav>

    <div class="hidden items-center gap-5 xl:flex">
      <button type="button" aria-label="Tìm kiếm" class="text-brand-950 hover:text-brand-600">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35M11 19a8 8 0 100-16 8 8 0 000 16Z" />
        </svg>
      </button>
      <a href="/lien-he" class="btn bg-red-600 text-white shadow-soft hover:bg-red-700">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.5-9.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 8.5-8.5Z" />
        </svg>
        Đặt nước
      </a>
      <a href="tel:<%= (site.hotline || '').replace(/\s+/g, '') %>" class="flex items-center gap-2 border-l border-slate-200 pl-5">
        <span class="flex h-9 w-9 items-center justify-center rounded-full bg-red-50 text-red-600">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.4 21 3 13.6 3 4.6 3 4 3.4 3.6 4 3.6h3.4c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.4 0 .8-.3 1.1L6.6 10.8Z"/></svg>
        </span>
        <span class="leading-tight">
          <span class="block text-[11px] font-semibold uppercase text-slate-400">ĐT/Zalo đặt hàng</span>
          <span class="block text-sm font-extrabold text-red-600 sm:text-base">
            <%= site.hotline %><% if (site.hotline_2) { %> - <%= site.hotline_2 %><% } %>
          </span>
        </span>
      </a>
    </div>

    <button id="menu-toggle" type="button" aria-label="Mở menu" class="flex h-10 w-10 items-center justify-center rounded-lg text-brand-700 xl:hidden">
      <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
      <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="hidden h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden border-t border-slate-100 bg-white xl:hidden">
    <nav class="container-page flex flex-col gap-1 py-4">
      <% navItems.forEach(function(item) { %>
        <a href="<%= item.href %>" class="rounded-lg px-3 py-2.5 text-sm font-bold uppercase <%= currentPath === item.href ? 'bg-brand-50 text-brand-700' : 'text-brand-950' %>">
          <%= item.label %>
        </a>
      <% }); %>
      <a href="/lien-he" class="btn mt-2 w-full bg-red-600 text-white hover:bg-red-700">Đặt nước</a>
      <a href="tel:<%= (site.hotline || '').replace(/\s+/g, '') %>" class="mt-1 block px-3 text-sm font-extrabold text-red-600">📞 <%= site.hotline %><% if (site.hotline_2) { %> - <%= site.hotline_2 %><% } %></a>
    </nav>
  </div>
</header>

<!-- Floating sticky contact widgets -->
<div class="fixed bottom-24 right-5 z-40 flex flex-col gap-3">
  <a href="<%= site.facebook_url || '#' %>" target="_blank" rel="noopener" aria-label="Facebook" class="flex h-12 w-12 items-center justify-center rounded-full bg-white shadow-card ring-1 ring-slate-100 transition hover:scale-105">
    <svg class="h-6 w-6 text-brand-600" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06C2 17.08 5.66 21.23 10.44 22v-7.03H7.9v-2.9h2.54V9.85c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.87h2.78l-.44 2.9h-2.34V22C18.34 21.23 22 17.08 22 12.06Z"/></svg>
  </a>
  <a href="<%= site.zalo_url || '#' %>" target="_blank" rel="noopener" aria-label="Chat Zalo" class="flex h-12 w-12 items-center justify-center rounded-full bg-blue-500 text-white shadow-card transition hover:scale-105">
    <span class="text-xs font-black">Zalo</span>
  </a>
</div>

<div class="fixed bottom-0 left-0 z-40 flex items-center gap-2 rounded-tr-xl bg-red-600 px-4 py-2.5 text-white shadow-card sm:bottom-5 sm:left-5 sm:rounded-full">
  <span>📞</span>
  <div class="leading-tight">
    <p class="text-[10px] font-semibold uppercase text-red-100">Call / Zalo đặt hàng</p>
    <a href="tel:<%= (site.hotline || '').replace(/\s+/g, '') %>" class="text-sm font-extrabold"><%= site.hotline %></a>
  </div>
</div>

<script>
  const menuToggle = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');
  menuToggle?.addEventListener('click', () => {
    mobileMenu.classList.toggle('hidden');
    iconOpen.classList.toggle('hidden');
    iconClose.classList.toggle('hidden');
  });
</script>
