<footer class="bg-gradient-to-b from-brand-700 to-brand-900 text-slate-100">
  <div class="container-page grid grid-cols-1 gap-10 py-16 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <img src="/images/logo-white.svg" alt="BMB Việt Nam" class="h-10 w-auto" />
      <p class="mt-4 text-sm leading-relaxed text-brand-100">
        Công ty TNHH BMB Việt Nam &mdash; đại lý phân phối chính thức nước khoáng Lavie khu vực Hà Nội.
      </p>
      <div class="mt-5 flex gap-3">
        <a href="<%= site.facebook_url || '#' %>" target="_blank" rel="noopener" aria-label="Facebook" class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 transition hover:bg-brand-500">
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06C2 17.08 5.66 21.23 10.44 22v-7.03H7.9v-2.9h2.54V9.85c0-2.5 1.49-3.89 3.77-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.87h2.78l-.44 2.9h-2.34V22C18.34 21.23 22 17.08 22 12.06Z"/></svg>
        </a>
        <a href="<%= site.zalo_url || '#' %>" target="_blank" rel="noopener" aria-label="Zalo" class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 transition hover:bg-brand-500">
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.03 2 11c0 2.86 1.5 5.4 3.84 7.06-.13.98-.5 2.4-1.34 3.6 0 0 2.2-.24 4.06-1.62.95.28 1.98.44 3.44.44 5.52 0 10-4.03 10-9S17.52 2 12 2Z"/></svg>
        </a>
      </div>
    </div>

    <div>
      <h4 class="font-display text-sm font-bold uppercase tracking-wider text-white">Liên kết nhanh</h4>
      <ul class="mt-4 space-y-3 text-sm">
        <li><a href="/gioi-thieu" class="transition hover:text-white">Giới thiệu công ty</a></li>
        <li><a href="/san-pham" class="transition hover:text-white">Sản phẩm</a></li>
        <li><a href="/phat-trien-ben-vung" class="transition hover:text-white">Cam kết dịch vụ</a></li>
        <li><a href="/tin-tuc" class="transition hover:text-white">Tin tức</a></li>
        <li><a href="/dai-ly" class="transition hover:text-white">Khu vực giao hàng</a></li>
        <li><a href="/tuyen-dung" class="transition hover:text-white">Tuyển dụng</a></li>
      </ul>
    </div>

    <div>
      <h4 class="font-display text-sm font-bold uppercase tracking-wider text-white">Liên hệ</h4>
      <ul class="mt-4 space-y-3 text-sm text-brand-100">
        <li class="flex gap-2"><span>📍</span><span><%= site.address %></span></li>
        <% if (site.address_2) { %>
          <li class="flex gap-2"><span>📍</span><span><%= site.address_2 %></span></li>
        <% } %>
        <li class="flex gap-2"><span>📞</span><span>ĐT/Zalo: <%= site.hotline %><% if (site.hotline_2) { %> - <%= site.hotline_2 %><% } %></span></li>
        <li class="flex gap-2"><span>✉️</span><span><%= site.email %></span></li>
        <li class="flex gap-2"><span>🕒</span><span><%= site.working_hours %></span></li>
      </ul>
    </div>

    <div>
      <h4 class="font-display text-sm font-bold uppercase tracking-wider text-white">Đăng ký nhận tin</h4>
      <p class="mt-4 text-sm text-brand-100">Nhận thông tin mới nhất về sản phẩm và ưu đãi từ BMB Việt Nam.</p>
      <form class="mt-4 flex overflow-hidden rounded-full bg-white/10 p-1">
        <input type="email" required placeholder="Email của bạn" class="w-full bg-transparent px-4 text-sm text-white placeholder:text-brand-100 focus:outline-none" />
        <button type="submit" class="shrink-0 rounded-full bg-brand-500 px-4 py-2 text-sm font-semibold text-white transition hover:bg-brand-400">Gửi</button>
      </form>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-page flex flex-col items-center justify-between gap-3 py-6 text-xs text-brand-100 sm:flex-row">
      <p>&copy; <%= new Date().getFullYear() %> <%= site.company_full_name %>. Đã đăng ký bản quyền.</p>
      <p>Giấy CNĐKKD số <%= site.tax_code %> do Sở Tài chính Hà Nội cấp.</p>
    </div>
  </div>
</footer>
