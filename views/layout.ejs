<!DOCTYPE html>
<html lang="vi" data-theme="<%= site.theme || 'default' %>">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <!-- Tells Chrome/Android WebView this page has its own light design, so
       they don't apply "force dark" auto-recoloring — that heuristic was
       washing out the brand-blue sections and muting text on some phones. -->
  <meta name="color-scheme" content="light" />
  <title><%= typeof title !== "undefined" ? title : "BMB Việt Nam" %></title>
  <meta name="description" content="<%= typeof description !== 'undefined' ? description : '' %>" />
  <% if (typeof keywords !== "undefined" && keywords) { %>
    <meta name="keywords" content="<%= keywords %>" />
  <% } %>
  <meta name="robots" content="index, follow" />
  <meta name="author" content="<%= site.company_full_name %>" />
  <link rel="canonical" href="<%= siteUrl %><%= currentPath %>" />

  <!-- Open Graph -->
  <%
    const resolvedOgImage = typeof ogImage !== "undefined" && ogImage
      ? (/^https?:\/\//.test(ogImage) ? ogImage : `${siteUrl}${ogImage}`)
      : `${siteUrl}/images/logo.svg`;
  %>
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="<%= siteName %>" />
  <meta property="og:locale" content="vi_VN" />
  <meta property="og:title" content="<%= typeof title !== 'undefined' ? title : siteName %>" />
  <meta property="og:description" content="<%= typeof description !== 'undefined' ? description : site.tagline %>" />
  <meta property="og:url" content="<%= siteUrl %><%= currentPath %>" />
  <meta property="og:image" content="<%= resolvedOgImage %>" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="<%= typeof title !== 'undefined' ? title : siteName %>" />
  <meta name="twitter:description" content="<%= typeof description !== 'undefined' ? description : site.tagline %>" />
  <meta name="twitter:image" content="<%= resolvedOgImage %>" />

  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 56 56'%3E%3Cpath fill='%230284c7' d='M28 4C28 4 12 24.5 12 35.5C12 44.6 19.2 52 28 52C36.8 52 44 44.6 44 35.5C44 24.5 28 4 28 4Z'/%3E%3C/svg%3E" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- All 3 theme font families load here; only the one selected via
       [data-theme] is actually applied (see src/input.css), so switching
       themes in Cài đặt never needs a new deploy. -->
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />

  <!-- Structured data: LocalBusiness / Store -->
  <%
    const sameAsLinks = [site.facebook_url, site.zalo_url].filter(Boolean);
    const storeSchema = {
      "@context": "https://schema.org",
      "@type": "Store",
      name: siteName,
      alternateName: site.company_full_name,
      description: "Đại lý phân phối chính thức nước khoáng Lavie, nước tinh khiết, nước đóng bình 19L tại Hà Nội. Giao nước tận nhà, tận văn phòng trong ngày.",
      url: siteUrl,
      logo: `${siteUrl}/images/logo.svg`,
      image: `${siteUrl}/images/logo.svg`,
      telephone: site.hotline,
      priceRange: "$$",
      address: {
        "@type": "PostalAddress",
        streetAddress: site.address,
        addressLocality: "Hà Nội",
        addressCountry: "VN"
      },
      areaServed: { "@type": "City", name: "Hà Nội" }
    };
    if (sameAsLinks.length) storeSchema.sameAs = sameAsLinks;
  %>
  <script type="application/ld+json"><%- JSON.stringify(storeSchema) %></script>
</head>
<body class="bg-sand-50 pb-14 text-slate-700 sm:pb-0">
  <%- include('partials/header') %>
  <%- include('partials/ad-banners') %>
  <main>
    <%- body %>
  </main>
  <%- include('partials/footer') %>
</body>
</html>
