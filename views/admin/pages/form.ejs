<%
  const isEdit = !!page;
  const action = isEdit ? `/admin/trang/${page.id}/sua` : '/admin/trang/moi';
%>
<div class="mb-6 flex items-center gap-3 text-sm text-slate-500">
  <a href="/admin/trang" class="hover:text-brand-600">Trang tuỳ chỉnh</a>
  <span>/</span>
  <span class="text-slate-700"><%= isEdit ? 'Sửa trang' : 'Thêm trang' %></span>
</div>

<form id="page-form" action="<%= action %>" method="POST" class="grid grid-cols-1 gap-6 lg:grid-cols-3">
  <div class="admin-card space-y-5 p-6 lg:col-span-2">
    <div>
      <label class="admin-label">Tiêu đề trang</label>
      <input type="text" name="title" required value="<%= page ? page.title : '' %>" class="admin-input" />
    </div>
    <div>
      <label class="admin-label">Đường dẫn (slug)</label>
      <div class="flex items-center gap-2">
        <span class="text-sm text-slate-400">/trang/</span>
        <input type="text" name="slug" value="<%= page ? page.slug : '' %>" class="admin-input" placeholder="Để trống sẽ tự sinh từ tiêu đề" />
      </div>
    </div>
    <div>
      <label class="admin-label">Mô tả ngắn (SEO, không bắt buộc)</label>
      <textarea name="meta_description" rows="2" class="admin-input"><%= page ? page.meta_description : '' %></textarea>
    </div>
    <div>
      <label class="admin-label">Nội dung trang</label>
      <input type="hidden" name="content" id="description-input" value="<%= page ? page.content : '' %>" />
      <div id="description-toolbar-mount" class="rounded-t-lg border border-b-0 border-slate-200 bg-slate-50"></div>
      <div id="description-editor" class="min-h-[320px] rounded-b-lg border border-slate-200 bg-white p-4"><%- page ? page.content : '' %></div>
      <p class="mt-2 text-xs text-slate-400">Có thể dán (Ctrl+V) hoặc kéo-thả ảnh trực tiếp vào khung soạn thảo.</p>
    </div>
  </div>

  <div class="space-y-6">
    <div class="admin-card p-6">
      <label class="admin-label">Trạng thái</label>
      <select name="status" class="admin-input">
        <option value="published" <%= !page || page.status === 'published' ? 'selected' : '' %>>Đang hiển thị</option>
        <option value="draft" <%= page && page.status === 'draft' ? 'selected' : '' %>>Nháp (ẩn)</option>
      </select>
      <div class="mt-4 flex gap-3">
        <button type="submit" class="admin-btn-primary w-full">💾 <%= isEdit ? 'Lưu thay đổi' : 'Tạo trang' %></button>
      </div>
    </div>
    <% if (isEdit) { %>
      <div class="admin-card p-6">
        <label class="admin-label">Gắn vào Menu</label>
        <p class="mt-1 text-xs text-slate-500">Dùng đường dẫn này khi thêm mục menu tại <a href="/admin/menu/moi" class="text-brand-600 hover:underline">Menu điều hướng</a>:</p>
        <code class="mt-2 block rounded-lg bg-slate-50 px-3 py-2 text-xs text-slate-700">/trang/<%= page.slug %></code>
      </div>
    <% } %>
  </div>
</form>

<script src="https://cdn.jsdelivr.net/npm/tinymce@6/tinymce.min.js" referrerpolicy="origin"></script>
<script src="/js/rich-editor.js"></script>
<script src="/js/page-editor.js"></script>
