<div class="mb-6 flex items-center gap-3 text-sm text-slate-500">
  <a href="/admin/lien-he" class="hover:text-brand-600">Liên hệ</a>
  <span>/</span>
  <span class="text-slate-700"><%= message.name %></span>
</div>

<div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
  <div class="admin-card p-6 lg:col-span-2">
    <div class="flex items-center justify-between">
      <h2 class="font-display text-lg font-bold text-slate-900"><%= message.name %></h2>
      <span class="text-xs text-slate-400"><%= formatDate(message.created_at) %></span>
    </div>
    <p class="mt-4 whitespace-pre-line text-sm leading-relaxed text-slate-600"><%= message.message %></p>
  </div>

  <div class="space-y-6">
    <div class="admin-card p-6">
      <h3 class="font-display text-sm font-bold text-slate-900">Thông tin liên hệ</h3>
      <dl class="mt-4 space-y-3 text-sm">
        <div>
          <dt class="text-xs font-semibold uppercase text-slate-400">Điện thoại</dt>
          <dd class="mt-0.5 font-semibold text-slate-800"><a href="tel:<%= message.phone %>" class="hover:text-brand-600"><%= message.phone || '—' %></a></dd>
        </div>
        <div>
          <dt class="text-xs font-semibold uppercase text-slate-400">Email</dt>
          <dd class="mt-0.5 text-slate-800"><%= message.email || '—' %></dd>
        </div>
      </dl>
    </div>

    <div class="admin-card p-6">
      <h3 class="font-display text-sm font-bold text-slate-900">Trạng thái</h3>
      <form action="/admin/lien-he/<%= message.id %>/trang-thai" method="POST" class="mt-4 space-y-3">
        <select name="status" class="admin-input">
          <option value="new" <%= message.status === 'new' ? 'selected' : '' %>>Mới</option>
          <option value="read" <%= message.status === 'read' ? 'selected' : '' %>>Đã đọc</option>
          <option value="replied" <%= message.status === 'replied' ? 'selected' : '' %>>Đã phản hồi</option>
        </select>
        <button type="submit" class="admin-btn-primary w-full">Cập nhật</button>
      </form>
      <form action="/admin/lien-he/<%= message.id %>/xoa" method="POST" data-confirm="Xoá liên hệ này?" class="mt-3">
        <button type="submit" class="admin-btn-danger w-full">🗑 Xoá liên hệ</button>
      </form>
    </div>
  </div>
</div>
