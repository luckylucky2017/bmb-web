<div class="mb-6">
  <h1 class="font-display text-xl font-bold text-slate-900">Cài đặt website</h1>
  <p class="mt-1 text-sm text-slate-500">Thông tin này hiển thị trên header, footer và trang liên hệ của website.</p>
</div>

<form id="settings-form" action="/admin/cai-dat" method="POST" enctype="multipart/form-data" class="admin-card mx-auto max-w-3xl space-y-5 p-6">
  <div class="grid grid-cols-2 gap-4">
    <div>
      <label class="admin-label">Tên hiển thị website</label>
      <input type="text" name="site_name" value="<%= settings.site_name %>" class="admin-input" />
    </div>
    <div>
      <label class="admin-label">Tên công ty đầy đủ</label>
      <input type="text" name="company_full_name" value="<%= settings.company_full_name %>" class="admin-input" />
    </div>
  </div>
  <div>
    <label class="admin-label">Khẩu hiệu / Vị thế thương hiệu</label>
    <input type="text" name="tagline" value="<%= settings.tagline %>" class="admin-input" placeholder="Đại lý phân phối chính thức nước khoáng Lavie khu vực Hà Nội" />
  </div>
  <div class="grid grid-cols-2 gap-4">
    <div>
      <label class="admin-label">Hotline / Zalo 1</label>
      <input type="text" name="hotline" value="<%= settings.hotline %>" class="admin-input" />
    </div>
    <div>
      <label class="admin-label">Hotline / Zalo 2</label>
      <input type="text" name="hotline_2" value="<%= settings.hotline_2 %>" class="admin-input" />
    </div>
  </div>
  <div>
    <label class="admin-label">Email liên hệ</label>
    <input type="email" name="email" value="<%= settings.email %>" class="admin-input" />
  </div>
  <div class="grid grid-cols-2 gap-4">
    <div>
      <label class="admin-label">Địa chỉ kho số 01</label>
      <input type="text" name="address" value="<%= settings.address %>" class="admin-input" />
    </div>
    <div>
      <label class="admin-label">Địa chỉ kho số 02</label>
      <input type="text" name="address_2" value="<%= settings.address_2 %>" class="admin-input" />
    </div>
  </div>
  <div class="grid grid-cols-2 gap-4">
    <div>
      <label class="admin-label">Giờ làm việc</label>
      <input type="text" name="working_hours" value="<%= settings.working_hours %>" class="admin-input" />
    </div>
    <div>
      <label class="admin-label">Mã số thuế</label>
      <input type="text" name="tax_code" value="<%= settings.tax_code %>" class="admin-input" />
    </div>
  </div>
  <div class="grid grid-cols-2 gap-4">
    <div>
      <label class="admin-label">Facebook URL</label>
      <input type="text" name="facebook_url" value="<%= settings.facebook_url %>" class="admin-input" placeholder="https://facebook.com/..." />
    </div>
    <div>
      <label class="admin-label">Zalo URL</label>
      <input type="text" name="zalo_url" value="<%= settings.zalo_url %>" class="admin-input" placeholder="https://zalo.me/..." />
    </div>
  </div>
  <div id="banner" class="scroll-mt-24 border-t border-slate-100 pt-5">
    <label class="admin-label">Banner trang chủ (hero)</label>
    <p class="mb-3 text-xs text-slate-400">Nội dung khối lớn đầu trang chủ.</p>
    <div class="space-y-4">
      <div>
        <label class="admin-label">Tiêu đề chính</label>
        <input type="text" name="hero_title" value="<%= settings.hero_title %>" class="admin-input" />
      </div>
      <div>
        <label class="admin-label">Mô tả phụ</label>
        <textarea name="hero_subtitle" rows="2" class="admin-input"><%= settings.hero_subtitle %></textarea>
      </div>
      <div>
        <label class="admin-label">Ảnh nền banner</label>
        <% if (settings.hero_image) { %>
          <div class="mb-3 aspect-[16/6] overflow-hidden rounded-lg bg-slate-50">
            <img src="<%= settings.hero_image %>" alt="" class="h-full w-full object-cover" />
          </div>
        <% } %>
        <input type="file" name="hero_image_file" accept="image/*" class="admin-input" />
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="admin-label">Nút bấm 1 - Chữ</label>
          <input type="text" name="hero_cta_text" value="<%= settings.hero_cta_text %>" class="admin-input" />
        </div>
        <div>
          <label class="admin-label">Nút bấm 1 - Liên kết</label>
          <input type="text" name="hero_cta_link" value="<%= settings.hero_cta_link %>" class="admin-input" placeholder="/san-pham" />
        </div>
      </div>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="admin-label">Nút bấm 2 - Chữ</label>
          <input type="text" name="hero_cta_text_2" value="<%= settings.hero_cta_text_2 %>" class="admin-input" />
        </div>
        <div>
          <label class="admin-label">Nút bấm 2 - Liên kết</label>
          <input type="text" name="hero_cta_link_2" value="<%= settings.hero_cta_link_2 %>" class="admin-input" placeholder="/dai-ly" />
        </div>
      </div>
    </div>
  </div>

  <div>
    <label class="admin-label">Giao diện website</label>
    <p class="mb-3 text-xs text-slate-400">Đổi màu sắc và font chữ của toàn bộ trang công khai (không ảnh hưởng trang quản trị). Áp dụng ngay sau khi lưu, không cần deploy lại.</p>
    <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
      <label class="block cursor-pointer">
        <input type="radio" name="theme" value="default" class="peer sr-only" <%= (!settings.theme || settings.theme === 'default') ? 'checked' : '' %> />
        <div class="rounded-xl border-2 border-slate-200 p-4 transition peer-checked:border-brand-600 peer-checked:ring-2 peer-checked:ring-brand-100">
          <div class="flex gap-1.5">
            <span class="h-6 w-6 rounded-full" style="background:#0284c7"></span>
            <span class="h-6 w-6 rounded-full" style="background:#dc2626"></span>
          </div>
          <p class="mt-3 text-sm font-bold text-slate-900">Mặc định</p>
          <p class="text-xs text-slate-500">Xanh dương Lavie · Be Vietnam Pro</p>
        </div>
      </label>
      <label class="block cursor-pointer">
        <input type="radio" name="theme" value="tin-cay" class="peer sr-only" <%= settings.theme === 'tin-cay' ? 'checked' : '' %> />
        <div class="rounded-xl border-2 border-slate-200 p-4 transition peer-checked:border-brand-600 peer-checked:ring-2 peer-checked:ring-brand-100">
          <div class="flex gap-1.5">
            <span class="h-6 w-6 rounded-full" style="background:#1d7a8c"></span>
            <span class="h-6 w-6 rounded-full" style="background:#c97a2b"></span>
          </div>
          <p class="mt-3 text-sm font-bold text-slate-900">Tin cậy</p>
          <p class="text-xs text-slate-500">Navy · Teal · Plus Jakarta Sans</p>
        </div>
      </label>
      <label class="block cursor-pointer">
        <input type="radio" name="theme" value="nang-dong" class="peer sr-only" <%= settings.theme === 'nang-dong' ? 'checked' : '' %> />
        <div class="rounded-xl border-2 border-slate-200 p-4 transition peer-checked:border-brand-600 peer-checked:ring-2 peer-checked:ring-brand-100">
          <div class="flex gap-1.5">
            <span class="h-6 w-6 rounded-full" style="background:#0b4cff"></span>
            <span class="h-6 w-6 rounded-full" style="background:#e08e00"></span>
          </div>
          <p class="mt-3 text-sm font-bold text-slate-900">Năng động</p>
          <p class="text-xs text-slate-500">Xanh điện · Manrope</p>
        </div>
      </label>
    </div>
  </div>

  <button type="submit" class="admin-btn-primary w-full">💾 Lưu cài đặt</button>
</form>
