<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== "undefined" ? title : "BMB Việt Nam CMS" %></title>
  <meta name="robots" content="noindex, nofollow" />
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 56 56'%3E%3Cpath fill='%231476c7' d='M28 4C28 4 12 24.5 12 35.5C12 44.6 19.2 52 28 52C36.8 52 44 44.6 44 35.5C44 24.5 28 4 28 4Z'/%3E%3C/svg%3E" />
</head>
<body class="min-h-screen bg-sand-100 font-sans text-slate-700">
  <div class="flex min-h-screen">
    <%- include('partials/sidebar') %>

    <div class="flex min-h-screen min-w-0 flex-1 flex-col lg:pl-64">
      <%- include('partials/topbar') %>

      <main class="min-w-0 flex-1 overflow-x-hidden p-4 sm:p-6 lg:p-8">
        <% if (flashSuccess && flashSuccess.length) { %>
          <div class="mb-6 flex items-start gap-3 rounded-xl border border-leaf-500/30 bg-leaf-500/10 px-4 py-3 text-sm font-semibold text-leaf-700">
            <span>✓</span>
            <div><% flashSuccess.forEach(function(msg) { %><p><%= msg %></p><% }); %></div>
          </div>
        <% } %>
        <% if (flashError && flashError.length) { %>
          <div class="mb-6 flex items-start gap-3 rounded-xl border border-red-300 bg-red-50 px-4 py-3 text-sm font-semibold text-red-600">
            <span>⚠</span>
            <div><% flashError.forEach(function(msg) { %><p><%= msg %></p><% }); %></div>
          </div>
        <% } %>

        <%- body %>
      </main>
    </div>
  </div>

  <script src="/js/admin.js"></script>
</body>
</html>
