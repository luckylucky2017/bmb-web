<%
  const isEdit = !!category;
  const action = isEdit ? `/admin/danh-muc/${category.id}/sua` : '/admin/danh-muc/moi';
%>
<div class="mb-6 flex items-center gap-3 text-sm text-slate-500">
  <a href="/admin/danh-muc?type=<%= type %>" class="hover:text-brand-600">Danh mục</a>
  <span>/</span>
  <span class="text-slate-700"><%= isEdit ? 'Sửa danh mục' : 'Thêm danh mục' %></span>
</div>

<form id="category-form" action="<%= action %>" method="POST" class="max-w-xl">
  <div class="admin-card space-y-5 p-6">
    <div>
      <label class="admin-label">Loại danh mục</label>
      <select name="type" class="admin-input">
        <option value="product" <%= type === 'product' ? 'selected' : '' %>>Sản phẩm</option>
        <option value="post" <%= type === 'post' ? 'selected' : '' %>>Tin tức</option>
      </select>
    </div>
    <div>
      <label class="admin-label">Tên danh mục</label>
      <input type="text" name="name" required value="<%= category ? category.name : '' %>" class="admin-input" placeholder="Nước khoáng thiên nhiên" />
    </div>
    <div>
      <label class="admin-label">Đường dẫn (slug)</label>
      <input type="text" name="slug" value="<%= category ? category.slug : '' %>" class="admin-input" placeholder="Để trống sẽ tự sinh từ tên" />
    </div>
    <div>
      <label class="admin-label">Thứ tự hiển thị</label>
      <input type="number" name="sort_order" value="<%= category ? category.sort_order : 0 %>" class="admin-input" />
    </div>
    <button type="submit" class="admin-btn-primary w-full">💾 <%= isEdit ? 'Lưu thay đổi' : 'Tạo danh mục' %></button>
  </div>
</form>
