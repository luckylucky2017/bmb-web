<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= title %></title>
  <meta name="robots" content="noindex, nofollow" />
  <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body class="flex min-h-screen items-center justify-center bg-gradient-to-br from-brand-950 via-brand-800 to-aqua-700 px-4 font-sans">
  <div class="w-full max-w-md">
    <div class="mb-8 flex flex-col items-center text-center text-white">
      <img src="/images/logo-white.svg" alt="BMB Việt Nam" class="h-12 w-auto" />
      <p class="mt-4 text-sm font-semibold uppercase tracking-widest text-brand-200">Hệ thống quản trị nội dung</p>
    </div>

    <div class="rounded-2xl bg-white p-8 shadow-card">
      <h1 class="font-display text-xl font-bold text-slate-900">Đăng nhập quản trị</h1>
      <p class="mt-1 text-sm text-slate-500">Nhập thông tin tài khoản để truy cập trang quản trị.</p>

      <% if (flashError && flashError.length) { %>
        <div class="mt-5 rounded-lg bg-red-50 px-4 py-3 text-sm font-semibold text-red-600">
          <% flashError.forEach(function(msg) { %><p><%= msg %></p><% }); %>
        </div>
      <% } %>

      <form action="/admin/login" method="POST" class="mt-6 space-y-5">
        <div>
          <label class="text-sm font-semibold text-slate-700">Email</label>
          <input type="email" name="email" value="<%= typeof email !== 'undefined' ? email : '' %>" required <%= typeof captchaSvg === 'undefined' || !captchaSvg ? 'autofocus' : '' %> class="mt-2 w-full rounded-lg border border-slate-200 px-4 py-2.5 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
        </div>
        <div>
          <label class="text-sm font-semibold text-slate-700">Mật khẩu</label>
          <input type="password" name="password" required class="mt-2 w-full rounded-lg border border-slate-200 px-4 py-2.5 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
        </div>
        <% if (typeof captchaSvg !== 'undefined' && captchaSvg) { %>
          <div>
            <label class="text-sm font-semibold text-slate-700">Mã xác nhận</label>
            <p class="mt-1 text-xs text-slate-400">Đăng nhập sai nhiều lần — nhập đúng mã bên dưới để tiếp tục.</p>
            <div class="mt-2 flex items-center gap-3">
              <div id="captcha-box" class="shrink-0 overflow-hidden rounded-lg border border-slate-200"><%- captchaSvg %></div>
              <button type="button" id="captcha-refresh" class="text-xs font-semibold text-brand-600 hover:underline">Đổi mã khác</button>
            </div>
            <input type="text" name="captcha" required autofocus autocomplete="off" placeholder="Nhập mã trong ảnh" class="mt-2 w-full rounded-lg border border-slate-200 px-4 py-2.5 text-sm focus:border-brand-500 focus:outline-none focus:ring-2 focus:ring-brand-100" />
          </div>
        <% } %>
        <button type="submit" class="btn-primary w-full">Đăng nhập</button>
      </form>
    </div>

    <p class="mt-6 text-center text-xs text-brand-200">
      <a href="/" class="hover:text-white">&larr; Về trang chủ website</a>
    </p>
  </div>
  <script src="/js/login.js"></script>
</body>
</html>
