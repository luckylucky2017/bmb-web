<%
  const STATUS_META = {
    new: { label: "Mới", cls: "bg-blue-100 text-blue-700" },
    confirmed: { label: "Đã xác nhận", cls: "bg-amber-100 text-amber-700" },
    shipping: { label: "Đang giao", cls: "bg-brand-100 text-brand-700" },
    completed: { label: "Hoàn tất", cls: "bg-leaf-500/15 text-leaf-700" },
    cancelled: { label: "Đã huỷ", cls: "bg-red-100 text-red-700" }
  };
%>
<div class="grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-4">
  <div class="admin-card p-6">
    <div class="flex items-center justify-between">
      <p class="text-sm font-semibold text-slate-500">Doanh thu (đơn đã xác nhận)</p>
      <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-leaf-500/10 text-xl">💰</span>
    </div>
    <p class="mt-3 font-display text-2xl font-extrabold text-slate-900"><%= formatVND(stats.revenue) %></p>
  </div>
  <div class="admin-card p-6">
    <div class="flex items-center justify-between">
      <p class="text-sm font-semibold text-slate-500">Đơn hàng</p>
      <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-50 text-xl">🧾</span>
    </div>
    <p class="mt-3 font-display text-2xl font-extrabold text-slate-900"><%= stats.orders %></p>
    <p class="mt-1 text-xs font-semibold text-red-500"><%= stats.ordersNew %> đơn mới chờ xử lý</p>
  </div>
  <div class="admin-card p-6">
    <div class="flex items-center justify-between">
      <p class="text-sm font-semibold text-slate-500">Sản phẩm</p>
      <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-aqua-500/10 text-xl">🧴</span>
    </div>
    <p class="mt-3 font-display text-2xl font-extrabold text-slate-900"><%= stats.products %></p>
    <p class="mt-1 text-xs font-semibold text-slate-400"><%= stats.productsPublished %> đang hiển thị</p>
  </div>
  <div class="admin-card p-6">
    <div class="flex items-center justify-between">
      <p class="text-sm font-semibold text-slate-500">Tin tức &amp; Liên hệ</p>
      <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-leaf-500/10 text-xl">📰</span>
    </div>
    <p class="mt-3 font-display text-2xl font-extrabold text-slate-900"><%= stats.posts %> bài viết</p>
    <p class="mt-1 text-xs font-semibold text-red-500"><%= stats.messagesNew %> liên hệ chưa đọc</p>
  </div>
</div>

<div class="mt-6 grid grid-cols-1 gap-6 xl:grid-cols-3">
  <div class="admin-card p-6 xl:col-span-2">
    <div class="flex items-center justify-between">
      <h2 class="font-display text-base font-bold text-slate-900">Đơn hàng gần đây</h2>
      <a href="/admin/don-hang" class="text-sm font-semibold text-brand-600 hover:underline">Xem tất cả</a>
    </div>
    <div class="mt-4 overflow-x-auto">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Mã đơn</th>
            <th>Khách hàng</th>
            <th>Tổng tiền</th>
            <th>Trạng thái</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% if (!recentOrders.length) { %>
            <tr><td colspan="5" class="py-8 text-center text-slate-400">Chưa có đơn hàng nào.</td></tr>
          <% } %>
          <% recentOrders.forEach(function(o) { %>
            <tr>
              <td class="font-semibold text-slate-900"><%= o.code %></td>
              <td><%= o.customer_name %><br /><span class="text-xs text-slate-400"><%= o.phone %></span></td>
              <td class="font-semibold text-red-600"><%= formatVND(o.total_amount) %></td>
              <td><span class="badge <%= STATUS_META[o.status].cls %>"><%= STATUS_META[o.status].label %></span></td>
              <td><a href="/admin/don-hang/<%= o.id %>" class="text-sm font-semibold text-brand-600 hover:underline">Chi tiết</a></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>

  <div class="admin-card p-6">
    <div class="flex items-center justify-between">
      <h2 class="font-display text-base font-bold text-slate-900">Liên hệ mới</h2>
      <a href="/admin/lien-he" class="text-sm font-semibold text-brand-600 hover:underline">Xem tất cả</a>
    </div>
    <div class="mt-4 space-y-4">
      <% if (!recentMessages.length) { %>
        <p class="py-8 text-center text-sm text-slate-400">Chưa có liên hệ nào.</p>
      <% } %>
      <% recentMessages.forEach(function(m) { %>
        <a href="/admin/lien-he/<%= m.id %>" class="block rounded-xl border border-slate-100 p-3.5 hover:border-brand-200 hover:bg-brand-50/40">
          <div class="flex items-center justify-between">
            <p class="text-sm font-bold text-slate-900"><%= m.name %></p>
            <% if (m.status === 'new') { %><span class="badge bg-red-100 text-red-700">Mới</span><% } %>
          </div>
          <p class="mt-1 line-clamp-1 text-xs text-slate-500"><%= m.message %></p>
        </a>
      <% }); %>
    </div>
  </div>
</div>

<div class="mt-6 admin-card p-6">
  <div class="flex items-center justify-between">
    <h2 class="font-display text-base font-bold text-slate-900">Bài viết gần đây</h2>
    <a href="/admin/tin-tuc/moi" class="admin-btn-primary">+ Viết bài mới</a>
  </div>
  <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-5">
    <% recentPosts.forEach(function(p) { %>
      <a href="/admin/tin-tuc/<%= p.id %>/sua" class="group overflow-hidden rounded-xl border border-slate-100 hover:border-brand-200">
        <div class="aspect-[16/10] overflow-hidden bg-slate-100">
          <img src="<%= p.image %>" alt="" class="h-full w-full object-cover transition group-hover:scale-105" />
        </div>
        <div class="p-3">
          <p class="line-clamp-2 text-xs font-bold text-slate-800"><%= p.title %></p>
          <span class="badge mt-2 <%= p.status === 'published' ? 'bg-leaf-500/15 text-leaf-700' : 'bg-slate-100 text-slate-600' %>"><%= p.status === 'published' ? 'Đã đăng' : 'Nháp' %></span>
        </div>
      </a>
    <% }); %>
  </div>
</div>
